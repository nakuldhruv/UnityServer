@model List<DockerWebApp.Models.Submission>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="row">
    <div class="col-md-5">
        <h2>提交姓名和邮箱</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <form asp-controller="Home" asp-action="Submit" method="post" class="row g-3 mb-4">
            <div class="col-12">
                <label for="Name" class="form-label">姓名</label>
                <input type="text" class="form-control" id="Name" name="Name" required maxlength="100"/>
            </div>
            <div class="col-12">
                <label for="Email" class="form-label">邮箱</label>
                <input type="email" class="form-control" id="Email" name="Email" required maxlength="200"/>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">提交</button>
            </div>
        </form>
    </div>

    <div class="col-md-7">
        <h2>已提交的名称和邮箱</h2>

        @if (Model.Count > 0)
        {
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">姓名</th>
                    <th scope="col">邮箱</th>
                    <th scope="col">提交时间</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var submission in Model.OrderByDescending(s => s.SubmittedAt))
                {
                    <tr>
                        <td>@submission.Id</td>
                        <td>@submission.Name</td>
                        <td>@submission.Email</td>
                        <td>@submission.SubmittedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">还没有任何提交，快来做第一个吧！</p>
        }
    </div>
</div>